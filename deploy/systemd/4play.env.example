# Copy to /etc/4play/4play.env on the Linux runtime/control server.
# Keep this file private on real installations because it contains bearer tokens.

FOURPLAY_CONTROL_PLANE_BIND=0.0.0.0:8080
FOURPLAY_CONTROL_PLANE_DATABASE=/var/lib/4play/control-plane.sqlite3
FOURPLAY_RUNTIME_HOST_OFFLINE_SECONDS=10

FOURPLAY_SEAT_API_TOKEN=replace-with-seat-token-at-least-16-chars
FOURPLAY_RUNTIME_HOST_API_TOKEN=replace-with-host-token-at-least-16-chars

FOURPLAY_MEDIA_PORT_START=41000
FOURPLAY_MEDIA_PORT_COUNT=100
FOURPLAY_INPUT_PORT_START=42000
FOURPLAY_INPUT_PORT_COUNT=100

FOURPLAY_ASSET_ROOT=/home/blake/src/4-play/data/assets
FOURPLAY_PREVIEW_STALE_MS=5000
# Experimental WebRTC browser-media spike proxy. Leave unset/blank in
# production until the standalone publisher is intentionally running.
FOURPLAY_WEBRTC_TEST_PATTERN_PUBLISHER_URL=http://127.0.0.1:18080/offer
# Required while the control plane proxies signaling to the local spike
# publisher. Without this, browser mDNS ICE candidates are rewritten to
# 127.0.0.1 because the publisher only sees the control-plane proxy.
FOURPLAY_WEBRTC_BROWSER_HOST_IP=192.168.20.10
# Experimental runtime-host-owned WebRTC test-pattern supervision. Keep this
# off unless intentionally testing the host-agent-owned publisher lifecycle. Do
# not also run 4play-webrtc-spike-publisher.service on the same bind address.
FOURPLAY_WEBRTC_TEST_PATTERN_SUPERVISED=0
FOURPLAY_WEBRTC_TEST_PATTERN_BIND=127.0.0.1:18080
FOURPLAY_WEBRTC_TEST_PATTERN_SCRIPT=/home/blake/src/4-play/tools/webrtc-gst-test-pattern.py
FOURPLAY_WEBRTC_TEST_PATTERN_ANSWER_FILE=/tmp/4play-webrtc-answer.sdp
# Experimental per-session WebRTC publisher advertising. Keep this off for the
# normal FFplay path. Enable only when intentionally testing browser-native
# real-session media.
FOURPLAY_WEBRTC_SESSION_PUBLISHERS=0
# Bounded browser receivers per MAME session, including players and spectators.
# Each receiver currently owns an independent encoder; measure CPU before raising.
FOURPLAY_WEBRTC_MAX_PEERS=8
FOURPLAY_WEBRTC_SESSION_BIND_ADDRESS=127.0.0.1
FOURPLAY_WEBRTC_SESSION_PORT_START=43000
FOURPLAY_WEBRTC_SESSION_PORT_COUNT=100
FOURPLAY_WEBRTC_SESSION_PUBLISHER_SCRIPT=/home/blake/src/4-play/tools/webrtc-gst-raw-session-publisher.py
FOURPLAY_WEBRTC_SESSION_ANSWER_DIRECTORY=/tmp/4play/webrtc-answers
# Control-plane proxy target for runtime-host-owned session publishers. The
# port placeholder maps to:
#   FOURPLAY_WEBRTC_SESSION_PORT_START + (input_udp_port - FOURPLAY_INPUT_PORT_START)
FOURPLAY_WEBRTC_SESSION_PUBLISHER_URL_TEMPLATE=http://127.0.0.1:{webrtc_signal_port}/sessions/{session_id}/offer

FOURPLAY_CONTROL_PLANE_URL=http://127.0.0.1:8080
FOURPLAY_RUNTIME_HOST_ID=reference-linux
FOURPLAY_RUNTIME_HOST_NAME=Reference Linux Runtime Host
FOURPLAY_RUNTIME_HOST_ADDRESS=192.168.20.68
FOURPLAY_HEARTBEAT_SECONDS=1
FOURPLAY_RECONCILE_MILLISECONDS=2000

FOURPLAY_SESSION_RUNTIME_PATH=/home/blake/src/4-play/target/release/session-runtime
FOURPLAY_RUNTIME_STATE_DIRECTORY=/tmp/4play/host-agent
FOURPLAY_PREVIEW_DIRECTORY=/home/blake/src/4-play/data/assets/previews
FOURPLAY_PREVIEW_ASSET_PREFIX=/assets/previews
FOURPLAY_PREVIEW_INTERVAL_MS=1000
FOURPLAY_PREVIEW_ENABLED=1
FOURPLAY_STARTUP_MEDIA_TIMEOUT_SECONDS=30

FOURPLAY_MAME_PATH=/home/blake/src/mame-4play/mame
FOURPLAY_MAME_INI_PATH=/opt/4play/config/mame
FOURPLAY_CATALOG_PATH=/home/blake/src/4-play/catalog/test-catalog.json
